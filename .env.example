# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# LineFlow server WebSocket auth token — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
LINEFLOW_AUTH_TOKEN=

# Allowed WebSocket Origins (optional, comma-separated, default: * for local dev)
# Example: https://your-domain.duckdns.org
LINEFLOW_ALLOWED_ORIGINS=
